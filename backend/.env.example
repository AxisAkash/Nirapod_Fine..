ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nirapod:nirapod@localhost:5432/nirapod
CORS_ORIGINS=["http://localhost:3000"]

# dev: accepts "Authorization: Bearer dev-user" or "dev-admin". clerk: verifies real Clerk session tokens.
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
ADMIN_EMAILS=[]

MAX_UPLOAD_MB=10

# AI via OpenRouter (optional). Leave the key empty to type receipt details by hand.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
AI_EXPLANATIONS=true
AI_READS_PER_HOUR=20

# Blockchain audit (optional). Run `npx hardhat node` and `npm run deploy` in contracts/, then set this to true.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
